      "name": "mock_player.scenarios.list",
      "executable": "mock-player",
      "arguments": [
        "scenarios",
        "list"
      ],
      "parameters": {},
      "append_arguments": [
        "--json"
      ],
      "output_family": "player",
      "read_only": true,
      "output_schema": "scenarios"
    },
    {
      "name": "mock_player.scenarios.show",
