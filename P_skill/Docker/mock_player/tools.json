{
  "schema_version": 3,
  "description": "通用采集、秒级消费及领取时窗口工具。无作业票和消费者配置。",
  "deployment_command": "mock-player serve --data-dir ./data",
  "global_parameters": {
    "server": {
      "type": "string",
      "default": "http://127.0.0.1:5010"
    },
    "timeout": {
      "type": "number",
      "default": 10
    }
  },
  "exit_codes": {
    "0": "success_or_no_work",
    "1": "failure",
    "2": "invalid_argument",
    "3": "not_found",
    "4": "conflict_or_expired_lease",
    "5": "unreachable",
    "130": "interrupted"
  },
  "tools": [
