  "output_schemas": {
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "state",
        "time_range",
        "attempt_count",
        "cutoff_sequence"
      ],
      "properties": {
        "task_id": {
          "type": "integer"
        },
        "state": {
          "enum": [
            "pending",
            "processing",
            "completed",
            "retryable",
            "failed"
          ]
        },
        "time_range": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "attempt_count": {
          "type": "integer"
        },
        "cutoff_sequence": {
          "type": "integer"
        },
        "lease_token": {
          "type": "string",
          "description": "Only present in a successful claim; required for worker mutations"
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "source",
        "record_ref",
        "data"
      ],
      "properties": {
        "source": {
          "enum": [
            "cv",
            "sensor",
            "position",
            "ppe"
          ]
        },
        "record_ref": {
          "type": "object",
          "required": [
            "table",
            "id"
          ],
          "properties": {
            "table": {
              "enum": [
                "cv_observations",
                "sensor_readings",
                "position_readings",
                "ppe_second_stats"
              ]
            },
            "id": {
              "type": "integer"
            }
          }
        },
        "data": {
          "type": "object"
        },
        "processing": {
          "type": "object"
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "result_id",
        "result_seq",
        "received_at",
        "duplicate"
      ],
      "properties": {
        "result_id": {
          "type": "string"
        },
        "result_seq": {
          "type": "integer"
        },
        "received_at": {
          "type": "string"
        },
        "duplicate": {
          "type": "boolean"
        }
      }
    },
    "player": {
      "type": "object",
      "required": [
        "state",
        "scenario",
        "current_second",
        "counts"
      ]
    },
    "data_status": {
      "type": "object",
      "required": [
        "database",
        "counts",
        "earliest_time",
        "committed_through",
        "persons",
        "sensors",
        "areas"
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "status",
        "task"
      ],
      "properties": {
        "status": {
          "enum": [
            "claimed",
            "no_work"
          ]
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "task_id",
                "state",
                "time_range",
                "attempt_count",
                "cutoff_sequence"
              ],
              "properties": {
                "task_id": {
                  "type": "integer"
                },
                "state": {
                  "enum": [
                    "pending",
                    "processing",
                    "completed",
                    "retryable",
                    "failed"
                  ]
                },
                "time_range": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "attempt_count": {
                  "type": "integer"
                },
                "cutoff_sequence": {
                  "type": "integer"
                },
                "lease_token": {
                  "type": "string",
                  "description": "Only present in a successful claim; required for worker mutations"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "complete": {
      "type": "object",
      "required": [
        "task",
        "receipt"
      ],
      "properties": {
        "task": {
          "type": "object",
          "required": [
            "task_id",
            "state",
            "time_range",
            "attempt_count",
            "cutoff_sequence"
          ],
          "properties": {
            "task_id": {
              "type": "integer"
            },
            "state": {
              "enum": [
                "pending",
                "processing",
                "completed",
                "retryable",
                "failed"
              ]
            },
            "time_range": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "attempt_count": {
              "type": "integer"
            },
            "cutoff_sequence": {
              "type": "integer"
            },
            "lease_token": {
              "type": "string",
              "description": "Only present in a successful claim; required for worker mutations"
            }
          }
        },
        "receipt": {
          "type": "object",
          "required": [
            "result_id",
            "result_seq",
            "received_at",
            "duplicate"
          ],
          "properties": {
            "result_id": {
              "type": "string"
            },
            "result_seq": {
              "type": "integer"
            },
            "received_at": {
              "type": "string"
            },
            "duplicate": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "fail": {
      "type": "object",
      "required": [
        "task",
        "duplicate"
      ],
      "properties": {
        "task": {
          "type": "object",
          "required": [
            "task_id",
            "state",
            "time_range",
            "attempt_count",
            "cutoff_sequence"
          ],
          "properties": {
            "task_id": {
              "type": "integer"
            },
            "state": {
              "enum": [
                "pending",
                "processing",
                "completed",
                "retryable",
                "failed"
              ]
            },
            "time_range": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "attempt_count": {
              "type": "integer"
            },
            "cutoff_sequence": {
              "type": "integer"
            },
            "lease_token": {
              "type": "string",
              "description": "Only present in a successful claim; required for worker mutations"
            }
          }
        },
        "duplicate": {
          "type": "boolean"
        }
      }
    },
    "tasks": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_id",
              "state",
              "time_range",
              "attempt_count",
              "cutoff_sequence"
            ],
            "properties": {
              "task_id": {
                "type": "integer"
              },
              "state": {
                "enum": [
                  "pending",
                  "processing",
                  "completed",
                  "retryable",
                  "failed"
                ]
              },
              "time_range": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "attempt_count": {
                "type": "integer"
              },
              "cutoff_sequence": {
                "type": "integer"
              },
              "lease_token": {
                "type": "string",
                "description": "Only present in a successful claim; required for worker mutations"
              }
            }
          }
        }
      }
    },
    "records_page": {
      "type": "object",
      "required": [
        "items",
        "next_cursor",
        "has_more",
        "cutoff_sequence"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "record_ref",
              "data"
            ],
            "properties": {
              "source": {
                "enum": [
                  "cv",
                  "sensor",
                  "position",
                  "ppe"
                ]
              },
              "record_ref": {
                "type": "object",
                "required": [
                  "table",
                  "id"
                ],
                "properties": {
                  "table": {
                    "enum": [
                      "cv_observations",
                      "sensor_readings",
                      "position_readings",
                      "ppe_second_stats"
                    ]
                  },
                  "id": {
                    "type": "integer"
                  }
                }
              },
              "data": {
                "type": "object"
              },
              "processing": {
                "type": "object"
              }
            }
          }
        },
        "next_cursor": {
          "type": "string"
        },
        "has_more": {
          "type": "boolean"
        },
        "cutoff_sequence": {
          "type": "integer"
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "time_range",
        "cutoff_sequence",
