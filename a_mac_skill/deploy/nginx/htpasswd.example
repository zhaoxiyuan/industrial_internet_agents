# a/deploy/nginx/htpasswd.example
#
# 这是 htpasswd 文件的示例格式,真实部署时请:
#   1. cp htpasswd.example htpasswd
#   2. htpasswd -B admin <your-password>   (覆盖示例行)
#   3. 把 htpasswd 加入 .gitignore(已默认)
#
# htpasswd 命令工具:
#   - 安装:apt install apache2-utils
#   - 生成:htpasswd -B -c htpasswd <username>
#            -B = bcrypt(更安全,推荐)
#            -c = 创建新文件
#   - 加用户:htpasswd -B htpasswd <username>

admin:$2y$05$abcdefghijklmnopqrstuuO5KqVZxR3T5L5pYhJqfQzG5K7WZ0WNe
