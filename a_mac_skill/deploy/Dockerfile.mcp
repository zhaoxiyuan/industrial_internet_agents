FROM python:3.12-slim
WORKDIR /srv/app
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt 'mcp>=1.28,<2' 'uvicorn>=0.30,<1'
COPY scripts/client.py scripts/mcp_server.py ./scripts/
COPY agents/ ./agents/
COPY A7/ ./A7/
COPY A6_A7/ ./A6_A7/
COPY P8P9/ ./P8P9/
COPY feishu_gateway_cli/ ./feishu_gateway_cli/
CMD ["python", "-m", "scripts.mcp_server"]
