{
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "apiKey": "${CG_API_KEY}",
    "maxBodyBytes": 1048576,
    "allowQueryToken": false
  },
  "storage": {
    "directory": "../data"
  },
  "delivery": {
    "callbackUrl": null
  },
  "channels": {
    "loopback": {
      "enabled": false,
      "accounts": {}
    },
    "generic": {
      "enabled": false,
      "accounts": {}
    },
    "feishu": {
      "enabled": true,
      "accounts": {
        "P8": {
          "maxSkewSeconds": 300,
          "timeoutMs": 15000,
          "maxResponseBytes": 1048576,
          "domain": "${FEISHU_P8_DOMAIN}",
          "appId": "${FEISHU_P8_APP_ID}",
          "appSecret": "${FEISHU_P8_APP_SECRET}",
          "verificationToken": "${FEISHU_P8_VERIFICATION_TOKEN}"
        }
      }
    }
  }
}
