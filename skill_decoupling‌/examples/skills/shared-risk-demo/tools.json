{
  "version": 1,
  "tools": [
    {
      "name": "save",
      "description": "P6保存风险描述",
      "input_schema": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "source_id",
          "description"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed",
              "no_work"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "claim": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "record_id",
              "token"
            ],
            "additionalProperties": false
          },
          "assessment": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "reason": {
                  "type": "string"
                },
                "created": {
                  "type": "number"
                }
              },
              "required": [
                "action",
                "reason",
                "created"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "entry": "scripts/queue.py:save",
      "dependencies": [
        "sqlite3"
      ],
      "storage": [
        "queue"
      ],
      "timeout": 5
    },
