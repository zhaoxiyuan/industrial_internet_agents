{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "industrial.ai/v1alpha1"},
    "kind": {"const": "IndustrialSkillPackage"},
    "metadata": {
      "type": "object", "required": ["name", "version", "displayName"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "displayName": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "required": ["skill", "compatibility", "tools", "configuration", "services", "deployment", "dependencies", "lifecycle", "checks"],
      "properties": {
        "skill": {"type": "object", "required": ["entrypoint"], "properties": {"entrypoint": {"const": "SKILL.md"}}},
        "compatibility": {"type": "object", "required": ["adapterContract", "framework", "os", "architectures"], "properties": {
          "adapterContract": {"type": "string", "minLength": 1}, "framework": {"const": "langchain-langgraph"},
          "os": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "architectures": {"type": "array", "minItems": 1, "items": {"enum": ["amd64", "arm64"]}}
        }},
        "tools": {"type": "object", "required": ["catalog"], "properties": {"catalog": {"type": "string"}}},
        "configuration": {"type": "object", "required": ["schema", "authority"], "properties": {"schema": {"type": "string"}, "authority": {"type": "string"}}},
        "services": {"type": "array", "items": {"$ref": "#/$defs/service"}},
        "deployment": {"type": "object", "required": ["profiles"], "properties": {"profiles": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["id", "mode"], "properties": {
            "id": {"type": "string"}, "mode": {"enum": ["external", "local-docker", "kubernetes", "compose"]}, "bundleRef": {"type": "string"}
          }
        }}}},
        "dependencies": {"type": "object"},
        "lifecycle": {"type": "object", "required": ["disable", "retainBusinessData", "upgrade", "rollback"], "properties": {
          "disable": {"const": "drain"}, "retainBusinessData": {"type": "boolean"},
          "upgrade": {"type": "string"}, "rollback": {"type": "string"}
        }},
        "checks": {"type": "object", "required": ["required"], "properties": {"required": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
        "ui": {"type": "array", "items": {"type": "object", "required": ["id", "type"], "properties": {"id": {"type": "string"}, "type": {"enum": ["schema-form", "service-page"]}}}}
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["serviceId", "purpose", "required", "dependsOn", "image", "contract", "placement", "network", "resources", "storage", "config", "secrets", "health", "lifecycle", "shareScope", "profiles"],
      "properties": {
        "serviceId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "purpose": {"type": "string", "minLength": 1}, "required": {"type": "boolean"},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "image": {"type": "object", "required": ["repository", "supportedVersions", "verifiedDigest", "architectures"], "properties": {
          "repository": {"type": "string", "minLength": 1}, "supportedVersions": {"type": "array", "minItems": 1, "items": {"type": "string", "not": {"const": "latest"}}},
          "verifiedDigest": {"type": ["string", "null"]}, "architectures": {"type": "array", "minItems": 1, "items": {"enum": ["amd64", "arm64"]}}
        }},
        "contract": {"type": "object", "required": ["protocol", "version"]},
        "placement": {"type": "object", "required": ["serviceScope", "agentAccess"]},
        "network": {"type": "object", "required": ["ports", "exposure"]},
        "resources": {"type": "object", "required": ["cpu", "memory"]},
        "storage": {"type": "object", "required": ["paths", "retainOnUninstall", "backup"]},
        "config": {"type": "object"}, "secrets": {"type": "array", "items": {"type": "string"}},
        "health": {"type": "object", "required": ["type", "target"]},
        "lifecycle": {"type": "object", "required": ["ownership", "stop"]},
        "shareScope": {"enum": ["instance", "exclusive"]},
        "profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
