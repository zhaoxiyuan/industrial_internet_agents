# a/deploy/.env.example — a/ 子项目 Docker 部署环境变量占位
#
# 用法:
#   1. 复制本文件到 a/.env(覆盖或合并已有 a/.env)
#   2. 填入真实值
#   3. docker-compose.yml 通过 env_file: ../.env 自动加载
#
# 注意:a/.env 既是 docker env_file,也是 python 进程读 dotenv 的来源(通过 agents/* 启动时 load_dotenv),
# 所以同一个文件服务两端,key 必须保持兼容。

# ─── LLM / VL(给 a/agents/* 读)───────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.minimax.chat/v1
OPENAI_MODEL=MiniMax-M3

# ─── Channel Gateway(Node.js 8787) ───────────────────────────────
GATEWAY_HOST=http://gateway:8787          # 容器内走 service 名;宿主机访问是 http://127.0.0.1:8787
CG_API_KEY=your_gateway_api_key_16chars_min
CG_DEFAULT_ACCOUNT_ID=P8

# ─── 飞书凭据(feishu_gateway_cli/feishu_config_app.py 写盘的 key) ──
# P8 账户(单账户示范;多账户走 FEISHU_ACCOUNTS JSON,详见 feishu_config_app.py)
FEISHU_P8_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_P8_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_P8_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx

# 用户 / 群映射(必填,否则飞书消息分发找不到收件人)
FEISHU_GROUP_MAP='{"oc_xxx":{"name":"动火作业群","description":"P8 告警"}}'
FEISHU_USER_MAP='{"ou_xxx":{"role":"作业负责人","name":"张三"}}'

# ─── 部署相关(可选)──────────────────────────────────────────────
# 你的真实域名(已注册 + DNS A 记录到 103.236.71.83)
PUBLIC_DOMAIN=jlkwihudbifhaej.dpdns.org

# BasicAuth 账号(给 Nginx /admin/* 用,实际账号在 nginx/htpasswd 文件里;
# 这里只用来在 README 里展示,不会读这个值)
ADMIN_USER=admin
