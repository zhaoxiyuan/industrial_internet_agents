# a/deploy/Dockerfile.p8p9 — P8P9 状态机 Web 服务(Flask :8089)
#
# 入口命令来自 P8P9/web_server.py 的 main(),CLI 参数:--host/--port。
# 健康检查:由我们新增的 GET /api/health 路由处理(已加在 a/P8P9/web_server.py)。

FROM a-deploy-base

ARG http_proxy
ARG https_proxy
ARG no_proxy

COPY requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt \
 && pip install --no-cache-dir \
        'flask>=3.0' \
        'requests>=2.31'

COPY agents/             ./agents/
COPY A6_A7/              ./A6_A7/
COPY A7/                 ./A7/
COPY P8P9/               ./P8P9/
COPY feishu_gateway_cli/ ./feishu_gateway_cli/
COPY data/               ./data/
COPY agent_config/       ./agent_config/
COPY .env                ./.env

EXPOSE 8089

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8089/api/health || exit 1

# 注:web_server 启动后 worker 是同步 Flask(无 reloader)
CMD ["python", "-m", "P8P9.web_server", "--host", "0.0.0.0", "--port", "8089"]
